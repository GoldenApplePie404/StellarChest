# ============================================
# 星之匣 (StellarChest) 环境变量配置模板
# ============================================
# 使用方式：
#   1. 复制本文件为 .env
#   2. 修改 JWT_SECRET（必须改）
#   3. 如果默认端口 3000 被占用，修改 PORT
#   4. 如需启用 AI 功能，配置 AI_DEFAULT_* 或在前端设置页配置
#
# 迁移到新机器时：
#   - 首先安装 Node.js 22+ 和 npm
#   - 运行 npm install
#   - 复制原机的 data/ 和 prisma/data/ 目录
#   - 运行 start.bat
# ============================================

# ---------- 数据库 ----------
# SQLite 开发模式（默认）。路径相对于项目根目录
# 注意：该文件会自动创建，务必复制到新机器以保留数据
DATABASE_URL="file:./data/galgame_toolkit.db"

# PostgreSQL 生产模式（可选，注释掉上面，启用下面）
# DATABASE_URL="postgresql://user:password@localhost:5432/galgame_toolkit"

# ---------- JWT 认证（必须修改！）----------
# 请替换为至少 32 位随机字符串
# 可以使用: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-random-string-at-least-32-chars"

# JWT 过期时间（默认7天）
JWT_EXPIRES_IN="7d"

# ---------- 服务器 ----------
# 应用端口（默认 3000）
PORT=3000

# ---------- AI API（可选）----------
# 如果在前端 AI 设置页面中已配置，此处可留空
AI_DEFAULT_API_ENDPOINT=""
AI_DEFAULT_API_KEY=""
AI_DEFAULT_MODEL="gpt-3.5-turbo"

# Echo-1.5 开发测试 Key（可选，公开测试密钥，供「选中即试用」）
# 写入本地 .env 即可，不会进入公开仓库；留空则 Echo 预设不预填 Key
NEXT_PUBLIC_ECHO_DEV_TEST_KEY=""

# ---------- 文件上传 ----------
# 最大上传大小（字节，默认 50MB）
MAX_FILE_SIZE=52428800

# ---------- 系统依赖 ----------
# ffmpeg 路径（如果不在系统 PATH 中，请指定完整路径）
# Windows: "C:\\ffmpeg\\bin\\ffmpeg.exe"
# macOS: "/usr/local/bin/ffmpeg"
FFMPEG_PATH=""

# ---------- 数据目录 ----------
# 数据存储根目录（相对于项目根目录）
DATA_DIR="./data"

# ---------- 运行模式（桌面化改造）----------
# web        → 普通 Web 部署（Vercel / Docker / start.bat），默认值
# desktop    → Electron 桌面壳，启动时自动开启云端转发 + 系统数据目录
APP_MODE="web"

# 桌面版云端服务器地址（当 APP_MODE=desktop 时生效）
# 示例：https://stellar-chest.example.com
# 留空 → 桌面版运行时会提示用户「请先在设置中配置云端地址」
CLOUD_API_BASE=""
